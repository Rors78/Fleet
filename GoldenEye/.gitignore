# Runtime state — regenerated on each run
output/
__pycache__/
*.pyc
*.pyo

# Logs (rotated by bot)
*.log
*.log.1
*.log.2
*.log.3
*.log.4
*.log.5

# Backtest artifacts
bt_candles_cache.pkl
bt_regime_candles.pkl
bt_*.log
backtest_*.log

# Test artifacts
test_*.png
test_*.py

# Secrets + local-only config
.env
.env.*
.claude/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Startup diagnostics
startup.log
startup_err.txt
goldeneye_audit.log
goldeneye_factors.log
goldeneye_err.log*

# Archive — recovery snapshots, not source
archive/

# Local launcher overrides
launch.bat
launch_desktop.bat

# Stray downloads that land in this directory.
# Deliberately specific rather than a blanket *.png/*.zip: rendered cards and
# screenshots are worth committing when we choose to, and a broad rule would
# silently swallow them.
download*.png
download*.jpg
download*.jpeg
image
*.exe
*.msi
*.zip
*.7z
*.rar

# Scratch/debug artifacts
*.tmp
*.tmp.*
# PowerShell string-interpolation slip can create files literally named
# "@{restarts=System.Object[]; ...}.tmp" — covered by *.tmp above, but the
# leading-@ form is caught here too in case the suffix differs.
@{*
card_*.png
wired_*.png
preview_*.png
